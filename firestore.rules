rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rol del usuario autenticado, leyendo su propio documento en usuarios/{uid}
    function rolActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function esRolAdministrativo() {
      return request.auth != null &&
        rolActual() in ['AdminTI', 'Gerente', 'AnalistaNomina', 'AsistentePlanilla'];
    }

    // usuarios/{uid}: cada quien lee su propio documento;
    // AdminTI y AsistentePlanilla pueden leer a todos (consulta);
    // solo AdminTI puede crear o editar; nadie puede eliminar (se desactiva con "activo")
    match /usuarios/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         rolActual() == 'AdminTI' ||
         rolActual() == 'AsistentePlanilla');
      allow create: if request.auth != null && rolActual() == 'AdminTI';
      allow update: if request.auth != null && rolActual() == 'AdminTI';
      allow delete: if false;
    }

    // empleados: el personal administrativo puede leer/escribir todo;
    // un empleado solo puede leer su propio documento
    match /empleados/{empleadoId} {
      allow read: if request.auth != null &&
        (esRolAdministrativo() || resource.data.uid == request.auth.uid);
      allow write: if esRolAdministrativo();
    }

    // solicitudes: el dueño de la solicitud y el personal administrativo pueden leer;
    // solo el personal administrativo puede aprobar/rechazar (escribir cambios de estado)
    match /solicitudes/{solicitudId} {
      allow read: if request.auth != null &&
        (esRolAdministrativo() || resource.data.empleadoUid == request.auth.uid);
      allow create: if request.auth != null; // el empleado crea su propia solicitud
      allow update, delete: if esRolAdministrativo();
    }
  }
}
